# ChinaTravel product runtime configuration.
# Copy this file to .env and fill in your local DeepSeek key.

DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_TOP_P=0.00000001
DEEPSEEK_TRUST_ENV_PROXY=false

# Planner/API timeout in seconds. 900 = 15 minutes.
CHINATRAVEL_PLANNER_TIMEOUT_SEC=900

# Internal LLMNeSy symbolic search timeout in seconds. Keep this aligned with
# CHINATRAVEL_PLANNER_TIMEOUT_SEC when debugging long runs.
CHINATRAVEL_AGENT_SEARCH_TIMEOUT_SEC=900

# Show agent print logs in the uvicorn console as well as cache/*.log files.
CHINATRAVEL_AGENT_DEBUG_CONSOLE=false

# Capture every DeepSeek call, including the raw model response.
CHINATRAVEL_LLM_TRACE_ENABLED=true
CHINATRAVEL_LLM_TRACE_CONSOLE=true
CHINATRAVEL_LLM_TRACE_CONSOLE_PROMPTS=false
CHINATRAVEL_LLM_TRACE_DIR=cache/traces
