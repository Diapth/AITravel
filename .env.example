# ChinaTravel product runtime configuration.
# Copy this file to .env and fill in your local DeepSeek key.

DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_TOP_P=0.00000001
DEEPSEEK_TRUST_ENV_PROXY=false
# For DeepSeek models that support thinking mode, force normal non-thinking output.
DEEPSEEK_DISABLE_THINKING=false

# AMap Web Service key for demo endpoints:
# /api/amap-demo/pois, /api/amap-demo/hotels, /api/amap-demo/route, /api/amap-demo/weather
AMAP_WEB_SERVICE_KEY=

# Tavily real-time web evidence. The main planner only calls Tavily when
# TAVILY_REAL_TIME_ENABLED=true; otherwise the client and health check stay passive.
TAVILY_API_KEY=
# Backward-compatible fallback for existing local .env files:
# TAVILY_SEARCH_KEY=
TAVILY_REAL_TIME_ENABLED=false
CHINATRAVEL_TAVILY_SEARCH_DEPTH=basic
CHINATRAVEL_TAVILY_MAX_RESULTS=5
CHINATRAVEL_TAVILY_TIMEOUT_SEC=10

# Local private trip memory and realtime search cache.
CHINATRAVEL_TRIP_MEMORY_DB=travel_memory.sqlite
CHINATRAVEL_RAW_QUERY_RETENTION_DAYS=30

# Planner/API timeout in seconds. 900 = 15 minutes.
CHINATRAVEL_PLANNER_TIMEOUT_SEC=900

# Internal LLMNeSy symbolic search timeout in seconds. Keep this aligned with
# CHINATRAVEL_PLANNER_TIMEOUT_SEC when debugging long runs.
CHINATRAVEL_AGENT_SEARCH_TIMEOUT_SEC=900

# Show agent print logs in the uvicorn console as well as logs/*.log files.
CHINATRAVEL_AGENT_DEBUG_CONSOLE=false

# Capture every DeepSeek call, including the raw model response.
CHINATRAVEL_LLM_TRACE_ENABLED=true
CHINATRAVEL_LLM_TRACE_CONSOLE=true
CHINATRAVEL_LLM_TRACE_CONSOLE_PROMPTS=false
CHINATRAVEL_LLM_TRACE_DIR=logs
