# ChinaTravel Planner local configuration
# Copy this file to .env, then fill in the keys you actually use.
# Shell environment variables take precedence over values in .env.

# -----------------------------------------------------------------------------
# DeepSeek / OpenAI-compatible LLM
# -----------------------------------------------------------------------------
# Required for real planning, chat clarification, checklist generation, and AI helpers.
DEEPSEEK_API_KEY=
# Backward-compatible fallback. Leave empty unless your local tooling already uses it.
OPENAI_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_TOP_P=0.00000001
DEEPSEEK_TRUST_ENV_PROXY=false
# For models that support thinking mode, set true to force normal non-thinking output.
DEEPSEEK_DISABLE_THINKING=false

# -----------------------------------------------------------------------------
# Frontend dev server and browser map
# -----------------------------------------------------------------------------
# Vite dev server proxies /api to this FastAPI target.
VITE_API_TARGET=http://127.0.0.1:8000
# Optional AMap JSAPI key for the browser route map panel.
VITE_AMAP_API_KEY=
VITE_AMAP_SECURITY_CODE=

# -----------------------------------------------------------------------------
# AMap backend Web Service
# -----------------------------------------------------------------------------
# Optional but recommended for POI/hotel/weather/route demo endpoints and planner fallback.
# This must be an AMap Web Service key, not a JSAPI-only frontend key.
AMAP_WEB_SERVICE_KEY=

# -----------------------------------------------------------------------------
# Tavily real-time web evidence
# -----------------------------------------------------------------------------
# The planner only calls Tavily when TAVILY_REAL_TIME_ENABLED=true or the request
# explicitly enables realtime search. Keep false for fully local demos.
TAVILY_API_KEY=
# Backward-compatible fallback for older local .env files.
TAVILY_SEARCH_KEY=
TAVILY_REAL_TIME_ENABLED=false
CHINATRAVEL_TAVILY_SEARCH_DEPTH=basic
CHINATRAVEL_TAVILY_MAX_RESULTS=5
CHINATRAVEL_TAVILY_TIMEOUT_SEC=10

# -----------------------------------------------------------------------------
# Local SQLite memory and cache
# -----------------------------------------------------------------------------
# Stores conversations, messages, immutable plan versions, trip memory, feedback,
# realtime search cache, and recommendation recall data.
CHINATRAVEL_MEMORY_DB_PATH=travel_memory.sqlite
# Backward-compatible fallback. Keep the same value unless migrating old data.
CHINATRAVEL_TRIP_MEMORY_DB=travel_memory.sqlite
CHINATRAVEL_RAW_QUERY_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Planner timeouts
# -----------------------------------------------------------------------------
# 900 seconds = 15 minutes. Long real LLMNeSy runs can need several minutes.
CHINATRAVEL_PLANNER_TIMEOUT_SEC=900
CHINATRAVEL_AGENT_SEARCH_TIMEOUT_SEC=900

# -----------------------------------------------------------------------------
# Runtime logs and LLM traces
# -----------------------------------------------------------------------------
CHINATRAVEL_AGENT_DEBUG_CONSOLE=false
CHINATRAVEL_LLM_TRACE_ENABLED=true
CHINATRAVEL_LLM_TRACE_CONSOLE=true
CHINATRAVEL_LLM_TRACE_CONSOLE_PROMPTS=false
CHINATRAVEL_LLM_TRACE_DIR=logs
